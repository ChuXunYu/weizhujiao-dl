# 复制成 .env 再填（.env 已被 .gitignore 忽略，不会提交）
#
# 1) COURSE_LIST_URL：登录微助教 → 打开「课件」列表页 → 地址栏整段复制
#    关键参数是 courseid 与 openid；重新登录后 openid 可能变，变了就重新复制。
COURSE_LIST_URL="https://v18.teachermate.cn/wechat-pro-ssr/student/coursewareinfo?courseid=0000000&openid=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 2) COURSE_BUTTON_LOCATOR_XPATH：课件卡片上那个按钮的 XPath
#    取法：列表页 F12 → 选中课件标题旁的按钮 → 右键 Copy → Copy XPath
#    实测值形如 //*[@class='aK9HC-ZsTCNapKFaNj5fN']/button
COURSE_BUTTON_LOCATOR_XPATH="//*[@class='CHANGE_ME']/button"

# --- 可选（命令行同名参数优先） ---------------------------------------------
# 输出目录，默认 ./downloads
# OUT_DIR=downloads
# 断点状态文件，默认 <OUT_DIR>/.wzd-state.json
# STATE_FILE=.wzd-state.json
